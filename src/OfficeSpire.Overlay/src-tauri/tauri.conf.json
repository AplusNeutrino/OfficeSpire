{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OfficeSpire Overlay",
  "version": "0.6.0-alpha.4",
  "identifier": "com.officespire.overlay",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost ws://127.0.0.1:*; style-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "label": "main",
        "title": "OfficeSpire",
        "width": 420,
        "height": 640,
        "minWidth": 300,
        "minHeight": 380,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false
      }
    ]
  },
  "bundle": { "active": true, "targets": "all" }
}
